# SMART GRID Environment Configuration Template (No Secrets Committed)
# Copy to .env.local for local development or inject via platform secret store in production.

# Application & Runtime Mode
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SMART_GRID_DB_PATH=./data/smart_grid.db
# REQUIRED in production (min 32 high-entropy characters, never a placeholder)
SMART_GRID_SESSION_SECRET=replace-with-a-long-random-secret-in-production
# Set to false in production (when NODE_ENV=production, defaults to disabled unless explicitly true)
SMART_GRID_DEMO_MODE=true

# Bootstrap First Administrator (used when SMART_GRID_DEMO_MODE=false on fresh DB)
SMART_GRID_BOOTSTRAP_ADMIN_EMAIL=
SMART_GRID_BOOTSTRAP_ADMIN_PASSWORD=
SMART_GRID_BOOTSTRAP_ADMIN_NAME=

# Reverse Proxy & Transport Security
# Only set true when deployed behind a sanitizing TLS/proxy layer forwarding x-forwarded-for / x-forwarded-proto
SMART_GRID_TRUST_PROXY=false
# Force Strict-Transport-Security header emission over HTTPS/TLS in production
SMART_GRID_ENABLE_HSTS=false

# Transactional Email Delivery (Password Reset & Security Notices)
# Configure an HTTPS transactional mail relay webhook for operational delivery
SMART_GRID_EMAIL_WEBHOOK_URL=
SMART_GRID_EMAIL_WEBHOOK_TOKEN=
SMART_GRID_SMTP_FROM=no-reply@smartgrid.example
SMART_GRID_SMTP_HOST=
SMART_GRID_SMTP_PORT=
SMART_GRID_SMTP_USER=
SMART_GRID_SMTP_PASS=

# Optional AI Provider Configuration (Gemini or OpenAI-compatible)
# Leave empty to keep SMART GRID AI in truthful 503 INTEGRATION_REQUIRED mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Optional Career Fest 2026 showcase monthly AI quota cap (default 200)
SMART_GRID_CAREER_FEST_MONTHLY_AI_QUOTA=200

# Optional External Integration / Map / Observability Config
SMART_GRID_MAP_TILE_URL=
